# Shadow Credit Network — Frontend Environment
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the deployed addresses.
#
# DEPLOYMENT:
#   1. Add your private key to shadow-credit-network/.env:
#        PRIVATE_KEY=your_deployer_private_key_without_0x
#
#   2. Deploy all contracts (auto-writes frontend/.env.local):
#        cd shadow-credit-network
#        npx hardhat deploy-wave5 --network arb-sepolia
#
#   The deploy task writes frontend/.env.local automatically.
#   You do NOT need to fill this file manually after deployment.
# ─────────────────────────────────────────────────────────────────────────────

# Network
VITE_CHAIN_ID=421614
VITE_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
VITE_BLOCK_EXPLORER=https://sepolia.arbiscan.io

# ── Wave 3 Contracts (Arbitrum Sepolia — CoFHE enabled) ─────────────────────
# Automatically populated by deploy-wave5 task.
# When set, the frontend uses V3 contracts with FHE-gated loan approval,
# reputation wiring, and yield distribution. CoFHE is live on Arbitrum Sepolia.
VITE_CREDIT_ENGINE_V3_ADDRESS=0x271C860318f53CEE27cAFbf4884a64245Ed7e6aA
VITE_LOAN_POOL_V3_ADDRESS=0x18BcF54F77373e733aD4C082333eeF1BEA5B13db
VITE_DELEGATION_V2_ADDRESS=0xC7F98D54CCAF5260030375c4E5de49CC26db7767
VITE_REPUTATION_REGISTRY_ADDRESS=0xFC8839FD0274433cFf3392A408B003bB9cbe615c
VITE_CREDIT_DATA_WITH_ZK_ADDRESS=0x1aC239d085646262A903365684B024EbeD683fFa

# ── Wave 4 Contracts ──────────────────────────────────────────────────────────
VITE_GOVERNANCE_ADDRESS=0x468df21Fac24f49fb27507Cd4f0AA0e223d3CcF7
VITE_CREDIT_NFT_ADDRESS=0x0Fc811b348fE1dD73df1a9959952281E4Ab0B0e7

# ── Wave 5 Contracts ──────────────────────────────────────────────────────────
VITE_MULTI_ASSET_LOAN_POOL_ADDRESS=0xb0c432BA998787583C5D94C423c9F8A8705C7925
VITE_CROSS_CHAIN_CREDIT_BRIDGE_ADDRESS=0x2624B23580Ce69D32CF9911AdFDd4D28324C10FB
